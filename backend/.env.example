# Required (app fails to start without them)
MONGO_URI=
REDIS_URI=

# Cloudflare Workers AI. If unset the app boots but command endpoints return 503.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Clerk issuer URL (e.g. https://your-instance.clerk.accounts.dev).
# Leave empty to disable auth (every request runs as user "local").
CLERK_JWT_ISSUER=
CLERK_JWKS_TTL_SECONDS=3600

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# development enables /docs; anything else disables it
ENVIRONMENT=development
PORT=8000
# false opens a visible browser (local only)
HEADLESS=true
